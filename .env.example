# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register slash commands to one server only (instant). Leave empty for global (up to 1 hour).
DEV_GUILD_ID=

# Queue and playback limits
MAX_QUEUE_SIZE=100
MAX_TRACK_DURATION_SEC=7200
MAX_TRACKS_PER_USER=0
LEAVE_GRACE_MS=2000
RESOLVE_TIMEOUT_MS=15000
STREAM_START_TIMEOUT_MS=15000

# External binaries
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
YTDLP_COOKIES_FILE=

# local (yt-dlp inside this process) or remote (resolver sidecar, optional later)
MEDIA_PROVIDER=local
RESOLVER_URL=
RESOLVER_TOKEN=

LOG_LEVEL=info
